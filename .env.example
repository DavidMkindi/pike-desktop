# Copy this file to ".env" and fill in your values.

# --- AI provider credentials ---
OPENAI_API_KEY=sk-your-key-here

# Optional: any OpenAI-compatible endpoint (OpenAI, Groq, Together, OpenRouter, Ollama, LM Studio...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: default model used on startup
# OPENAI_MODEL=gpt-4o-mini

# --- Built-in provider overrides ---
# Providers declared in config.py can be overridden without editing the file.
# PIKE_OPENAI_API_KEY=sk-...
# PIKE_OPENAI_BASE_URL=https://api.openai.com/v1
# PIKE_ANTHROPIC_API_KEY=sk-ant-...
# PIKE_GOOGLE_API_KEY=AIza...

# --- Thinking / reasoning level (off, low, medium, high) ---
# PIKE_REASONING_EFFORT=medium

# --- App settings ---
PIKE_HOST=127.0.0.1
PIKE_PORT=8765
PIKE_DEBUG=false

# Set to "true" to run in the normal browser instead of the desktop window
PIKE_BROWSER_ONLY=false

# --- Updates (optional) ---
# JSON manifest describing the latest release, e.g.
#   {"version": "1.2.0", "url": "https://.../Pike.exe", "notes": "What's new"}
# PIKE_UPDATE_URL=https://example.com/pike/latest.json
# Where the "Update" button sends people when there is no manifest/download URL.
# PIKE_RELEASES_URL=https://github.com/your-user/pike/releases/latest